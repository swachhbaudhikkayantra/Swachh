<?xml version="1.0"?>
<!-- dynamic_sudden.sdf: obstacle-avoidance scenario (spec 09 5). Room 6x4 m, origin centre. Moving box hidden behind wall_hide. -->
<sdf version="1.9">
  <world name="avoid_dynamic_sudden_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.6 0.6 0.7 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction><cast_shadows>true</cast_shadows>
    </light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
      <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material></visual>
    </link></model>
    <model name="wall_n"><static>true</static><pose>0 2.05 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>6.3 0.1 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.3 0.1 1.0</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
    </link></model>
    <model name="wall_s"><static>true</static><pose>0 -2.05 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>6.3 0.1 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.3 0.1 1.0</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
    </link></model>
    <model name="wall_e"><static>true</static><pose>3.05 0 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.1 4.0 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 4.0 1.0</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
    </link></model>
    <model name="wall_w"><static>true</static><pose>-3.05 0 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.1 4.0 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 4.0 1.0</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
    </link></model>
    <model name="wall_hide"><static>true</static><pose>-0.5 -1.0 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.1 1.2 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 1.2 1.0</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
    </link></model>
    <model name="dyn_box_1"><static>false</static><pose>0.6 -1.3 0.25 0 0 0</pose><link name="link">
      <gravity>false</gravity>
      <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.4 0.4 0.5</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.4 0.4 0.5</size></box></geometry><material><ambient>0.9 0.2 0.1 1</ambient><diffuse>0.9 0.2 0.1 1</diffuse></material></visual>
    </link>
      <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
        <topic>/model/dyn_box_1/cmd_vel</topic>
      </plugin>
      <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>dyn_box_1</robot_base_frame>
        <odom_topic>/model/dyn_box_1/ground_truth_odom</odom_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <dimensions>2</dimensions>
        <gaussian_noise>0</gaussian_noise>
      </plugin>
    </model>
  </world>
</sdf>
