<?xml version="1.0"?>
<!-- u_trap.sdf: obstacle-avoidance scenario (spec 09 5). Room 6x4 m, origin centre. U opening towards S, G behind. -->
<sdf version="1.9">
  <world name="avoid_u_trap_world">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <scene><ambient>0.5 0.5 0.5 1</ambient><background>0.6 0.6 0.7 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional">
      <pose>0 0 5 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction><cast_shadows>true</cast_shadows>
    </light>
    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
      <visual name="v"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
      <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/floor_0.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
    </link></model>
    <model name="wall_n"><static>true</static><pose>0 2.05 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>6.3 0.1 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.3 0.1 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_08.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
    </link></model>
    <model name="wall_s"><static>true</static><pose>0 -2.05 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>6.3 0.1 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>6.3 0.1 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_13.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
    </link></model>
    <model name="wall_e"><static>true</static><pose>3.05 0 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.1 4.0 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 4.0 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_02.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
    </link></model>
    <model name="wall_w"><static>true</static><pose>-3.05 0 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.1 4.0 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 4.0 1.0</size></box></geometry><material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_11.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
    </link></model>
    <model name="u_back"><static>true</static><pose>1.0 0 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>0.1 2.1 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>0.1 2.1 1.0</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
    </link></model>
    <model name="u_arm_n"><static>true</static><pose>0.5 1.0 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>1.1 0.1 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.1 0.1 1.0</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
    </link></model>
    <model name="u_arm_s"><static>true</static><pose>0.5 -1.0 0.5 0 0 0</pose><link name="link">
      <collision name="c"><geometry><box><size>1.1 0.1 1.0</size></box></geometry></collision>
      <visual name="v"><geometry><box><size>1.1 0.1 1.0</size></box></geometry><material><ambient>0.8 0.8 0.75 1</ambient><diffuse>0.8 0.8 0.75 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
