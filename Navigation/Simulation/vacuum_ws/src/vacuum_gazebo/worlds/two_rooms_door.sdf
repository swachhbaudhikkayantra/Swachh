<?xml version="1.0"?>
<!--
  two_rooms_door.sdf  -  door traversal world (spec 09 sec 9.4)
  Room A: x in [-4.1,-0.1], y in [-2,2]; Room B: x in [0.1,4.1], y in [-2,2] (each 4.0 x 4.0 m).
  Shared wall x in [-0.1,0.1] with a 0.9 m door opening, y in [-0.45,0.45] (0.2 m deep).
  Obstacles: table_a box (-2.5,1.0) 0.8x0.5 ; pot_b cylinder (2.5,-1.0) r=0.25
  reachable_seed: (-2.0, 0.0)
  spawn candidates: room A (-2,0) (-3,-1) (-1.5,1) (-3,1.2) (-1.5,-1.2); room B (2,0) (3,1) (1.5,-1.2) (3.2,-1.5) (1.5,1.2)
-->
<sdf version="1.9">
  <world name="two_rooms_door_world">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.6 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/floor_3.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static><pose>0 2.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.6 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.6 0.2 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_07.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -2.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.6 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.6 0.2 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_12.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-4.2 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_01.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>4.2 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 4 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_10.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_mid_n">
      <static>true</static><pose>0 1.225 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 1.55 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 1.55 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_11.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_mid_s">
      <static>true</static><pose>0 -1.225 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 1.55 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 1.55 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_12.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="table_a">
      <static>true</static><pose>-2.5 1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.8 0.5 0.5</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.8 0.5 0.5</size></box></geometry>
          <material><ambient>0.6 0.4 0.25 1</ambient><diffuse>0.6 0.4 0.25 1</diffuse></material></visual>
      </link>
    </model>
    <model name="pot_b">
      <static>true</static><pose>2.5 -1 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry></collision>
        <visual name="vis"><geometry><cylinder><radius>0.25</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.2 0.6 0.3 1</ambient><diffuse>0.2 0.6 0.3 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
