<?xml version="1.0"?>
<!--
  maze_dead_ends.sdf  -  recovery / stuck world (spec 09 sec 9.4)
  Interior 8.0 x 6.0 m (x in [-4,4], y in [-3,3]); partitions (thickness 0.2) at y=-1.8,-0.6,0.6,1.8
  form five 1.0-1.1 m wide E-W bands snaking through gaps:
    p1 y=-1.8 x[-4,3] (gap east x 3..4) ; p2 y=-0.6 x[-3,4] (gap west x -4..-3)
    p3 y=0.6 x[-4,2] and x[3,4] (gap x 2..3) + wall_fill_b4 box (3.5,1.2) 1x1 closing band 4 east end
    p4 y=1.8 x[-3,4] (gap west -4..-3)
  Dead ends: (1) west end of band 1, (2) east end of band 5, (3) the 1x1 pocket east of the p3 gap at (3.5,0).
  reachable_seed: (0.0, 0.0)
  spawn candidates: (0,0) (-3,0) (2,0) (3.5,-1.2) (-3.5,-1.2) (-3.5,-2.4) (0,-1.2) (3.5,0) (0,1.2) (0,2.4)
-->
<sdf version="1.9">
  <world name="maze_dead_ends_world">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.6 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/floor_2.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static><pose>0 3.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.4 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.4 0.2 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_14.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -3.1 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>8.4 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>8.4 0.2 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_03.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_east">
      <static>true</static><pose>4.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_08.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_west">
      <static>true</static><pose>-4.1 0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 6 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.2 6 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_01.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_p1">
      <static>true</static><pose>-0.5 -1.8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>7 0.2 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_02.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_p2">
      <static>true</static><pose>0.5 -0.6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>7 0.2 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_03.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_p3a">
      <static>true</static><pose>-1 0.6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>6 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>6 0.2 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_04.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_p3b">
      <static>true</static><pose>3.5 0.6 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1 0.2 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_05.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_p4">
      <static>true</static><pose>0.5 1.8 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>7 0.2 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_06.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
    <model name="wall_fill_b4">
      <static>true</static><pose>3.5 1.2 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>1 1 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>1 1 3</size></box></geometry>
          <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><pbr><metal><albedo_map>textures/wall_07.png</albedo_map><roughness>1.0</roughness><metalness>0.0</metalness></metal></pbr></material></visual>
      </link>
    </model>
  </world>
</sdf>
