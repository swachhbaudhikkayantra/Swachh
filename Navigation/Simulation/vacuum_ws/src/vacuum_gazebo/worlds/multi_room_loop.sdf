<?xml version="1.0"?>
<!--
  multi_room_loop.sdf  -  loop-closure world (spec 09 sec 9.4)
  Four 3.5 x 3.5 m rooms in a ring (NE x,y in [0.1,3.6]; NW x in [-3.6,-0.1]; etc.), cross wall of
  thickness 0.2 on x=0 and y=0, outer walls at +-3.7. Four 0.9 m doors: x=0 wall at y=+-1.85,
  y=0 wall at x=+-1.85. Loop through the room centres (+-1.85,+-1.85) is ~14.8 m.
  Distinguishable objects (height 0.5):
    obj_ne_1: box (3.05,3.05) size 0.4x0.4
    obj_ne_2: box (3.05,1.55) size 0.6x0.3
    obj_ne_3: box (1.55,3.05) size 0.3x0.7
    obj_ne_4: box (0.75,0.75) size 0.5x0.5
    obj_nw_1: box (-3.05,3.05) size 0.7x0.3
    obj_nw_2: box (-3.05,1.55) size 0.4x0.4
    obj_nw_3: box (-1.55,3.05) size 0.3x0.5
    obj_sw_1: box (-3.05,-3.05) size 0.5x0.3
    obj_sw_2: box (-3.05,-1.55) size 0.3x0.3
    obj_sw_3: box (-1.55,-3.05) size 0.6x0.6
    obj_sw_4: box (-0.75,-0.75) size 0.4x0.3
    obj_se_1: box (3.05,-3.05) size 0.8x0.4
    obj_se_2: box (3.05,-1.55) size 0.5x0.5
    obj_se_3: cylinder (1.55,-3.05) r=0.2
  reachable_seed: (1.85, 1.85)
  spawn candidates: room centres (1.85,1.85) (-1.85,1.85) (-1.85,-1.85) (1.85,-1.85) and (0.9,2.5) (-2.8,0.9) (-0.9,-2.8) (2.8,-0.9)
-->
<sdf version="1.9">
  <world name="multi_room_loop_world">

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-contact-system"
            name="gz::sim::systems::Contact"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.6 0.6 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry></collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material><ambient>0.6 0.6 0.6 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static><pose>0 3.7 1.5 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>7.8 0.2 3</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>7.8 0.2 3</size></box></geometry>
          <material><ambient>0.85 0.85 0.82 1</ambient><diffuse>0.85 0.85 0.82 1</diffuse></material></visual>
      </link>
    </model>
    <model name="wall_south">
      <static>true</static><pose>0 -3.7 1.5 0 0 0</pose>
      <link name="link">
